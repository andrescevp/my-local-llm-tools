{
  "name": "my-local-llm-tools",
  "version": "2.0.0",
  "description": "Local-first, low-cost AI toolbelt — OpenCode V2 plugin with OCR, image/video analysis, TTS, skill generation, ComfyUI, and OpenAI-compatible API guidance.",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "validate": "node src/cli.mjs validate",
    "test": "node --test tests/*.test.mjs",
    "cli": "node src/cli.mjs",
    "harness:install": "node src/cli.mjs install",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "format": "biome format --write .",
    "deps": "depcruise src tests index.ts",
    "dup": "jscpd src tests",
    "security": "osv-scanner scan source -r . && semgrep --config .semgrep.yml --error .",
    "qa": "pnpm lint && pnpm typecheck && pnpm deps && pnpm dup && pnpm test && pnpm validate && pnpm security",
    "claude:validate": "claude plugin validate ."
  },
  "dependencies": {
    "@opencode/plugin": "2.1.3",
    "ajv": "^8.20.0",
    "chart.js": "^4.6.1",
    "ejs": "^7.0.2",
    "onnxruntime-node": "^1.30.0",
    "playwright": "^1.64.1",
    "pptxgenjs": "^4.0.1",
    "reveal.js": "^6.0.2",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "^18.7.0",
    "jscpd": "^5.4.2",
    "typescript": "^6.0.3"
  }
}

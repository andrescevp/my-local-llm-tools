{
  "name": "cheap-ai-winth-local-tools",
  "version": "1.0.0",
  "description": "Local-first, low-cost AI toolbelt — OpenCode V2 plugin with OCR, image analysis, TTS, skill generation, ComfyUI, Ollama, and llama.cpp skills.",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "manifest": "node scripts/build_manifest.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "cli": "node src/cli.mjs",
    "harness:install": "node scripts/install.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "deps": "depcruise src scripts tests index.ts",
    "dup": "jscpd src scripts tests",
    "security": "osv-scanner scan source -r . && semgrep --config .semgrep.yml --error .",
    "qa": "pnpm lint && pnpm deps && pnpm dup && pnpm test && pnpm validate && pnpm security"
  },
  "dependencies": {
    "@opencode/plugin": "latest",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "dependency-cruiser": "^18.7.0",
    "jscpd": "^5.4.2",
    "typescript": "^6.0.3"
  }
}

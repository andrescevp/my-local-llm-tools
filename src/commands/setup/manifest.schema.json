{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-local-llm-tools.local/manifest.schema.json",
  "title": "my-local-llm-tools manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plugin",
    "generated_at",
    "platform",
    "ok",
    "libre_office_path",
    "hosts",
    "models",
    "paths",
    "tools",
    "ollama",
    "features",
    "warnings"
  ],
  "properties": {
    "schema": { "const": 3 },
    "plugin": { "const": "my-local-llm-tools" },
    "generated_at": { "type": "string", "minLength": 1 },
    "libre_office_path": { "type": "string" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "release"],
      "properties": {
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "release": { "type": "string" }
      }
    },
    "ok": { "type": "boolean" },
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ollama"],
      "properties": {
        "ollama": { "type": "string", "minLength": 1 }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ollama"],
      "properties": {
        "ollama": { "$ref": "#/$defs/modelSet" }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tesseract", "ffmpeg", "ffprobe", "piper"],
      "properties": {
        "tesseract": { "type": "string" },
        "ffmpeg": { "type": "string" },
        "ffprobe": { "type": "string" },
        "piper": { "type": "string" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "pnpm",
        "uv",
        "php",
        "phpenv",
        "docker",
        "tesseract",
        "ffmpeg",
        "ffprobe",
        "piper",
        "voice_model",
        "libreoffice",
        "imagemagick",
        "hyprwhspr",
        "gimp",
        "inkscape",
        "potrace",
        "pdftoppm",
        "playwright",
        "u2net_model"
      ],
      "properties": {
        "node": { "$ref": "#/$defs/binary" },
        "pnpm": { "$ref": "#/$defs/binary" },
        "uv": { "$ref": "#/$defs/binary" },
        "php": { "$ref": "#/$defs/binary" },
        "phpenv": { "$ref": "#/$defs/binary" },
        "docker": { "$ref": "#/$defs/binary" },
        "tesseract": { "$ref": "#/$defs/tesseract" },
        "ffmpeg": { "$ref": "#/$defs/binary" },
        "ffprobe": { "$ref": "#/$defs/binary" },
        "piper": { "$ref": "#/$defs/binary" },
        "voice_model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "path"],
          "properties": {
            "ok": { "type": "boolean" },
            "path": { "type": "string" }
          }
        },
        "libreoffice": { "$ref": "#/$defs/binary" },
        "imagemagick": { "$ref": "#/$defs/binary" },
        "hyprwhspr": { "$ref": "#/$defs/binary" },
        "gimp": { "$ref": "#/$defs/binary" },
        "inkscape": { "$ref": "#/$defs/binary" },
        "potrace": { "$ref": "#/$defs/binary" },
        "pdftoppm": { "$ref": "#/$defs/binary" },
        "chrome": { "$ref": "#/$defs/binary" },
        "playwright": { "$ref": "#/$defs/binary" },
        "u2net_model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "path"],
          "properties": {
            "ok": { "type": "boolean" },
            "path": { "type": "string" }
          }
        }
      }
    },
    "ollama": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "reachable", "version", "models"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "reachable": { "type": "boolean" },
        "version": { "type": "string" },
        "models": { "$ref": "#/$defs/modelSet" },
        "error": { "type": "string" }
      }
    },
    "features": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ok", "requires", "optional"],
        "properties": {
          "ok": { "type": "boolean" },
          "requires": { "$ref": "#/$defs/requirements" },
          "optional": { "$ref": "#/$defs/requirements" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "version", "path"],
      "properties": {
        "ok": { "type": "boolean" },
        "version": { "type": "string" },
        "path": { "type": "string" },
        "error": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "tesseract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "version", "path", "languages"],
      "properties": {
        "ok": { "type": "boolean" },
        "version": { "type": "string" },
        "path": { "type": "string" },
        "error": { "type": "string" },
        "languages": { "type": "array", "items": { "type": "string" } }
      }
    },
    "modelSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "required", "missing"],
      "properties": {
        "available": { "type": "array", "items": { "type": "string" } },
        "required": { "type": "array", "items": { "type": "string" } },
        "missing": { "type": "array", "items": { "type": "string" } }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "ok"],
        "properties": {
          "requirement": { "type": "string" },
          "ok": { "type": "boolean" }
        }
      }
    }
  }
}
